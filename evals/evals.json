[
  {
    "name": "create-ckeditor5-plugin",
    "prompt": "Create a custom CKEditor 5 plugin",
    "assertions": [
      {
        "type": "tool_use",
        "tool": "Write",
        "description": "Creates plugin source files"
      },
      {
        "type": "content_contains",
        "value": "Plugin",
        "description": "Implements CKEditor 5 Plugin class"
      }
    ]
  },
  {
    "name": "migrate-rte-config",
    "prompt": "Migrate RTE config from CKEditor 4",
    "assertions": [
      {
        "type": "tool_use",
        "tool": "Read",
        "description": "Reads existing RTE configuration"
      },
      {
        "type": "content_contains",
        "value": "YAML",
        "description": "Produces YAML-based CKEditor 5 config"
      }
    ]
  }
]
